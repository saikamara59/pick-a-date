# Google Places API (New) key. Server-side only: read by netlify/functions/places.ts.
# Locally: copy to .env and run `npx netlify dev`. In production: set it in Netlify > Site settings > Environment variables.
GOOGLE_PLACES_API_KEY=

# Email notifications (Resend). NOTIFY_FROM can be the test sender until you verify a domain.
RESEND_API_KEY=
NOTIFY_FROM=Pick a Date <onboarding@resend.dev>
# Long random string; signs his email into invite links. Generate with: openssl rand -base64 32
SIGNING_SECRET=

# AI features (Claude). Optional; without a key they're skipped.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
